# Dentro de la red Docker de mosquitto/nodered:
MQTT_URL=mqtt://mosquitto:1883
# Desde fuera de esa red (por ejemplo, desarrollo local):
# MQTT_URL=wss://mqtt.stardest.com/mqtt

MQTT_USER=aircare
MQTT_PASS=cambia-esto

# Cadena aleatoria propia del dashboard (NO la contraseña del broker).
# Generar con: openssl rand -hex 32
DASHBOARD_TOKEN=cambia-esto

PORT=3001

# Orígenes permitidos para CORS, separados por coma. Vacío o "*" = cualquiera.
# CORS_ORIGIN=https://aircare.stardest.com,http://localhost:5173
